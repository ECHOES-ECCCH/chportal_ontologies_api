	<rdfs:label>HTML</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">
	<rdfs:label>langString</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">
	<rdfs:label>PlainLiteral</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/2002/07/owl#imports">
	<rdfs:label>imports</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/2008/05/skos-xl#Label">
	<rdfs:label xml:lang="en">Label</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
