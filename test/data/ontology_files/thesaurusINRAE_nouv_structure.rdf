</rdf:Description>

<rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<dc:description>This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts.</dc:description>
</rdf:Description>

